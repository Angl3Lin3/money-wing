# Copy this file to .env (same folder) and fill in the values.

# Your Postgres database. From Neon/Supabase, paste the connection string.
# With Postgres.app on your Mac: postgresql://localhost:5432/moneywing
DATABASE_URL="postgresql://localhost:5432/moneywing"

# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-string"

PORT=3000
PAYOUT_PROVIDER="mock"

# Stripe test keys: optional until we build payments.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Pricing (optional; these are the defaults) ---
# EXCHANGE_RATE_UGX_PER_CAD=2800
# FEE_PERCENT=2
# MIN_SEND_CAD=5
# MAX_SEND_CAD=3000
