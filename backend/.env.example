# Copy this file to .env (same folder) and fill in the values.

# Your Postgres database. From Neon/Supabase, paste the connection string.
# With Postgres.app on your Mac: postgresql://localhost:5432/moneywing
DATABASE_URL="postgresql://localhost:5432/moneywing"

# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-string"

PORT=3000
PAYOUT_PROVIDER="mock"

# Stripe test keys: optional until we build payments.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Pricing defaults (optional) ---
# Used until the owner saves pricing in the developer area (Owner controls tab).
# EXCHANGE_RATE_UGX_PER_CAD=2800
# FEE_PERCENT=2
# MIN_SEND_CAD=5
# MAX_SEND_CAD=3000

# --- Developer area ---
# Comma-separated emails of app accounts allowed into the developer area.
# Sign up in the app first, then put that email here. Empty = nobody.
ADMIN_EMAILS=""

# Optional, local development only: a ready-made developer account.
# The server creates it (already verified) at startup and lets it into the
# developer area. Ignored when NODE_ENV=production.
# DEV_ADMIN_EMAIL=""
# DEV_ADMIN_PASSWORD=""

# --- Email ---
# Leave SMTP_HOST empty while developing: emails aren't sent, they're shown in
# the developer area's Emails tab (and printed in the server window) instead.
# To really send, fill in your email service's SMTP details, for example:
#   Gmail:     smtp.gmail.com, port 587, your address + an "app password"
#   Resend:    smtp.resend.com, port 587, user "resend", password = API key
#   Mailtrap:  sandbox.smtp.mailtrap.io, port 2525 (catches test emails)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"   # "true" only for port 465
SMTP_USER=""
SMTP_PASS=""
# Who emails come from. Must be an address your email service lets you send as.
EMAIL_FROM="MoneyWing <no-reply@example.com>"
