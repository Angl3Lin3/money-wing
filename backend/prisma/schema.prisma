generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  status       String        @default("pending")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  kycStatus    String?
  otpTokens    OtpToken[]
  recipients   Recipient[]
  transactions Transaction[]
}

model OtpToken {
  id        String   @id @default(uuid())
  tokenHash String
  purpose   String   @default("signup")
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id                String            @id @default(uuid())
  cadAmount         Float
  fee               Float
  exchangeRate      Float
  ugxAmount         Float
  status            TransactionStatus @default(DRAFT)
  stripePaymentId   String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  userId            String
  recipientId       String
  provider          String?
  providerPayoutRef String?
  providerRaw       Json?
  recipient         Recipient         @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Recipient {
  id           String        @id @default(uuid())
  name         String
  phoneNumber  String
  network      String
  createdAt    DateTime      @default(now())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

enum TransactionStatus {
  DRAFT
  PAYMENT_PENDING
  FUNDED
  PAYOUT_PENDING
  COMPLETED
  PAYOUT_FAILED
  FAILED
  CANCELLED
}

// Settings the owner changes from the developer area (e.g. key "pricing").
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// A permanent record of every owner action (rate changes, payouts, cancels).
model AuditLog {
  id         String   @id @default(uuid())
  action     String
  targetId   String?
  details    Json?
  actorEmail String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
